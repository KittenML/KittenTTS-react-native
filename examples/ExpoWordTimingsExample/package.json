    "expo-build-properties": "~55.0.13",
    "expo-dev-client": "~55.0.28",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "@kittentts/react-native": "^1.1.0",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
