{
  "name": "expoexample",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:rebuild": "expo prebuild --clean --platform android && expo run:android",
    "ios": "expo run:ios",
    "ios:rebuild": "expo prebuild --clean --platform ios && expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@kittentts/espeak-ng": "^1.0.0",
    "@kittentts/react-native": "^2.0.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
