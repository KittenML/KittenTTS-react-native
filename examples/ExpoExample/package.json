{
  "name": "expoexample",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:rebuild": "expo prebuild --clean --platform android && expo run:android",
