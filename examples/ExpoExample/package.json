    "ios:rebuild": "expo prebuild --clean --platform ios && expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "@kittentts/react-native": "file:../../kittentts-react-native-0.8.0.tgz",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
